# Copy this file to .env and enter environment-specific values.
# Never commit or include the real .env in an application package.

SECRET_KEY=
DATABASE_URL=
PUBLIC_BASE_URL=http://127.0.0.1:5000
DEPLOYMENT_ENV=development
MAP_TILE_MODE=osm
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# For a self-contained regional map, set MAP_TILE_MODE=pmtiles and place
# the archive at static/maps/region.pmtiles (or change PMTILES_URL).
PMTILES_URL=/static/maps/region.pmtiles

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MAIL_SENDER_NAME=Drogo Aerospace

GEMINI_API_KEY=
THERMAL_SDK_DIR=

# local or s3
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_PREFIX=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=

# osm uses internet tiles; pmtiles serves one locally deployed archive.
MAP_TILE_MODE=osm
PMTILES_URL=/static/maps/region.pmtiles

# Set true behind HTTPS and set proxy count to the number of trusted proxies.
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_MINUTES=480
TRUST_PROXY_COUNT=0
ENABLE_HSTS=true
