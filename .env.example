# Copy this file to .env and fill in real values. Never commit .env itself.

SECRET_KEY=

# PostgreSQL (recommended). Format:
# postgresql://<user>:<password>@localhost:5432/<database>
DATABASE_URL=

# MSSQL alternative, if you ever switch back:
# DATABASE_URL=mssql+pyodbc://sa:YourPassword123!@localhost:1433/drogo_trans_pilot?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ── Mail (Gmail SMTP) ──────────────────────────────────────────────────────
# GMAIL_ADDRESS: the Gmail account that will send "welcome" emails to new users.
# GMAIL_APP_PASSWORD: a 16-character Gmail App Password (NOT your normal Gmail password).
#   Generate one at: https://myaccount.google.com/apppasswords
#   (requires 2-Step Verification to be enabled on the Gmail account)
# MAIL_SENDER_NAME: display name shown to recipients.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MAIL_SENDER_NAME=

# ── AI Assistant (chat widget, bottom-right on every page) ──────────────────
# Required for the assistant to work at all — without it, the chat widget
# still shows but every message returns "not configured yet" instead of a
# real response. Free tier, no credit card needed — get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
