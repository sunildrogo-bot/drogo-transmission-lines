# Copy to .env and provide real values. Never commit the production .env.
SECRET_KEY=
DATABASE_URL=

# Public application URL, for links sent by email.
PUBLIC_BASE_URL=

# Gmail SMTP
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MAIL_SENDER_NAME=

# AI assistant
GEMINI_API_KEY=
# Optional administrator-provided override stored outside source control.
GEMINI_API_KEY_OVERRIDE=

# Optional custom DJI Thermal SDK directory.
THERMAL_SDK_DIR=

