# Copy this file to .env and enter environment-specific values.
# Never commit or include the real .env in an application package.

SECRET_KEY=
DATABASE_URL=
PUBLIC_BASE_URL=http://127.0.0.1:5000
DEPLOYMENT_ENV=development
APP_HOST=127.0.0.1
APP_PORT=5000
MAP_TILE_MODE=osm
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# For a self-contained regional map, set MAP_TILE_MODE=pmtiles and place
# the archive at static/maps/region.pmtiles (or change PMTILES_URL).
PMTILES_URL=/static/maps/region.pmtiles

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MAIL_SENDER_NAME=Drogo Aerospace

GEMINI_API_KEY=
THERMAL_SDK_DIR=

# local or s3
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_PREFIX=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=

# Production web and SQLite settings.
# Dokploy terminates HTTPS at one trusted reverse proxy in the normal setup.
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_MINUTES=480
TRUST_PROXY_COUNT=0
ENABLE_HSTS=true
SQLITE_JOURNAL_MODE=WAL
SQLITE_BUSY_TIMEOUT_MS=30000
GUNICORN_BIND=0.0.0.0:8000
WEB_CONCURRENCY=2
WEB_THREADS=4
WEB_TIMEOUT_SECONDS=300
RUN_MIGRATIONS_ON_START=true

# Independent offsite backup destination. Credentials use the standard
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY variables supported by boto3.
BACKUP_OFFSITE_ENABLED=false
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_PREFIX=drogo-backups
BACKUP_OFFSITE_ENDPOINT_URL=
BACKUP_OFFSITE_REGION=
BACKUP_OFFSITE_RETENTION_COUNT=3
BACKUP_OFFSITE_INTERVAL_HOURS=24
BACKUP_OFFSITE_VERIFY_EVERY_FILE=true
BACKUP_OFFSITE_SSE=AES256
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional STARTTLS SMTP overrides (port 587; leave blank to use Gmail above).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
